# Copy to .env before running Docker Compose.
# Generate each secret independently, for example:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Browser origins permitted to call the API directly.
# Same-origin access through the bundled web proxy works without extra origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Upload / worker limits
MAX_UPLOAD_SIZE=536870912
MAX_ANALYSIS_TIME=3600
MAX_QUEUE_SIZE=16
LOG_LEVEL=INFO
